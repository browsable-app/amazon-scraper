{
  "name": "@browsable/amazon-scraper",
  "version": "0.1.0",
  "description": "Free, open-source Amazon scrapers using local Playwright. No API key or paid services required.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "amazon-scraper": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "scrape": "tsx src/cli.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.65.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/browsable-app/amazon-scraper.git"
  },
  "keywords": [
    "amazon",
    "scraper",
    "playwright",
    "web-scraping",
    "open-source"
  ]
}
